rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Samo admin sme da piše. Svi ostali smeju samo da čitaju.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'komidjomita@gmail.com';
    }

    match /players/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /matches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
